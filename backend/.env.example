# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Postgres — get from Supabase dashboard > Project Settings > Database > Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Upstash Redis — get from Upstash dashboard > your database > Redis connect (ioredis)
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary — get from Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin (MVP shared-secret for reviewing verification requests — swap for real admin roles later)
ADMIN_API_KEY=change-this-to-a-long-random-string

# Web Push (verification badge / new match / new message notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buddiespride.com

# LiveKit (video calls) — get from LiveKit Cloud dashboard, or your self-hosted
# LiveKit server. Leave blank to disable video calling (endpoints return 503).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
